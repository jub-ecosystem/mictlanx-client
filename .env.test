CLIENT_ID=test_put
# BUCKET_ID=test
MICTLANX_CLIENT_LOG_PATH=/mictlanx/client
# _______________________________
MICTLANX_URI=mictlanx://mictlanx-router-0@localhost:63666/?protocol=http&api_version=4&http2=0
MICTLANX_ROUTER_PORT=63666
MICTLANX_SUMMONER_PORT=15000
MICTLANX_TEST_PEER_PORT=25000

MICTLANX_LOG_PATH=./.mictlanx/log
MICTLANX_LOG_DISABLED=0
MICTLANX_LOG_LEVEL=DEBUG
MICTLANX_LOG_TO_FILE=1
MICTLANX_LOG_ROTATION_WHEN=h
MICTLANX_LOG_RORATION_INTERVAL=24
MICTLANX_LOG_RICH=0
MICTLANX_LOG_ERROR_FILE=0
MICTLANX_LOG_CONSOLE_LEVEL=DEBUG
MICTLANX_LOG_FILE_LEVEL=INFO
MICTLANX_LOG_JSON_INDENT=0
